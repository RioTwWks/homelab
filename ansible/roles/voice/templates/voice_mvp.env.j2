# Generated by Ansible — legacy (voice_backend=legacy)
MOLTBOT_API_BASE_URL=http://localhost:18080
MOLTBOT_SESSION_ID=home

RECORD_SECONDS=6
ALSA_DEVICE=default
RECORD_UNTIL_SILENCE=true
MAX_RECORD_SECONDS=12
SILENCE_STOP_SECONDS=0.8
SILENCE_THRESHOLD_PCT=2

WHISPER_CPP_DIR={{ whisper_cpp_dir }}
WHISPER_MODEL={{ whisper_cpp_dir }}/models/ggml-{{ whisper_model_name }}.bin
WHISPER_LANG=ru
WHISPER_SERVER_URL=http://127.0.0.1:{{ whisper_server_port }}
WHISPER_SERVER_THREADS=8
WHISPER_PROMPT="Домашний голосовой ассистент. Команды: погода, новости, включи, выключи, открой, запусти."

TTS_ENGINE={{ tts_engine }}
PIPER_MODEL={{ ansible_env.HOME }}/.local/share/piper/ru_RU-voice.onnx
PIPER_SPEAKER=0
PIPER_BIN={{ piper_venv }}/bin/piper

SILERO_VENV={{ silero_venv }}
SILERO_PY={{ silero_venv }}/bin/python
SILERO_LANGUAGE=ru
SILERO_SPEAKER_MODEL=v3_1_ru
SILERO_VOICE=eugene
SILERO_NORMALIZE_RU=true

TTS_TEMPO=0.9
TTS_PAD_MS=120
NEWS_ITEM_PAUSE_SECONDS=0.2
