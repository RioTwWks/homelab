# Generated by Ansible — Hermes voice (Phase 2) + optional NPU STT (Phase 4)
# Docs: docs/voice-mvp.md, docs/wake-word.md, docs/hermes-voice-npu.md

model:
  provider: ollama
  base_url: {{ hermes_ollama_base_url }}
  model: {{ hermes_llm_model }}
  context_length: {{ hermes_context_length }}

skills:
  paths:
    - ~/.hermes/skills
    - {{ moltbot_install_dir }}/hermes/skills

tools:
  enabled_toolsets:
    - terminal

wake_word:
  enabled: false
  provider: openwakeword
  phrase: "{{ hermes_wake_word_en }}"
  sensitivity: 0.6
  confirmation_frames: 3
  start_new_session: true
  openwakeword:
    model: hey_hermes

stt:
{% if hermes_enable_npu_stt | bool %}
  provider: openai
  language: "{{ hermes_stt_language }}"
  openai:
    model: whisper-large-v3-turbo
    base_url: "http://127.0.0.1:{{ flm_serve_port }}/v1"
{% else %}
  provider: local
  language: "{{ hermes_stt_language }}"
  local:
    model: "{{ hermes_faster_whisper_model }}"
    language: "{{ hermes_stt_language }}"
{% endif %}

tts:
  provider: edge
  edge:
    voice: "{{ hermes_edge_voice }}"
    speed: 1.0

npu:
  enabled: {{ hermes_enable_npu_stt | bool }}
  provider: fastflowlm
  tasks:
    - stt

voice:
  middleware:
    enabled: {{ hermes_speaker_middleware_enabled | bool }}
    url: "{{ hermes_speaker_middleware_url }}"
    process_path: /process_voice
