# Base URL of our API (docker)
MOLTBOT_API_BASE_URL=http://localhost:18080
MOLTBOT_SESSION_ID=home

# Record settings
RECORD_SECONDS=6
ALSA_DEVICE=default

# Optional: stop recording when you go silent (recommended).
# Requires `sox` (command `rec`).
RECORD_UNTIL_SILENCE=true
MAX_RECORD_SECONDS=12
SILENCE_STOP_SECONDS=0.6
SILENCE_THRESHOLD_PCT=2

# whisper.cpp settings (host)
WHISPER_CPP_DIR=$HOME/.local/src/whisper.cpp
WHISPER_MODEL=$HOME/.local/src/whisper.cpp/models/ggml-large-v3.bin
WHISPER_LANG=ru

# Optional: use a pre-warmed whisper-server for faster STT
# Start it with scripts/whisper_server_run.sh and set:
WHISPER_SERVER_URL=http://127.0.0.1:8099
WHISPER_SERVER_THREADS=10
WHISPER_SERVER_BEST_OF=1
WHISPER_SERVER_BEAM_SIZE=1
WHISPER_SERVER_NO_TIMESTAMPS=true

# Optional: bias STT towards assistant commands
WHISPER_PROMPT="Домашний голосовой ассистент. Команды: погода, новости, включи, выключи, открой, запусти."

# TTS engine: piper | silero
TTS_ENGINE=silero

# Piper settings (host)
# Point this to a .onnx model file you downloaded.
PIPER_MODEL=$HOME/.local/share/piper/ru_RU-voice.onnx
PIPER_SPEAKER=0
PIPER_BIN=$HOME/.venvs/piper/bin/piper

# Silero settings (host)
SILERO_VENV=$HOME/.venvs/silero
SILERO_PY=$HOME/.venvs/silero/bin/python
SILERO_LANGUAGE=ru
SILERO_SPEAKER_MODEL=v3_1_ru
SILERO_VOICE=eugene
SILERO_NORMALIZE_RU=true

# Playback tempo factor (<1.0 slower, >1.0 faster). Requires sox.
TTS_TEMPO=0.9

# Add a short silence at the start to avoid clipping first syllable.
TTS_PAD_MS=120

# Pause between news items (seconds)
NEWS_ITEM_PAUSE_SECONDS=0.15

# --- Wake word (openWakeWord) ---
# Run: python scripts/wakeword_openwakeword.py (after source this file or set vars)
# On detection runs WAKE_WORD_COMMAND (default: scripts/voice_mvp.sh)
# Wake phrase: built-in by name, or path to your .onnx (see docs/wake-word.md)
# OPENWAKEWORD_MODEL=                    # path to .onnx = своя фраза; имя встроенной (hey_mycroft, alexa, …) = одна фраза; пусто = все встроенные
OPENWAKEWORD_BUILTIN=hey_jarvis       # или несколько через запятую: hey_mycroft,alexa (игнорирует OPENWAKEWORD_MODEL для встроенных)
# WAKE_WORD_COMMAND=bash scripts/voice_mvp.sh
WAKE_WORD_THRESHOLD=0.7
WAKE_WORD_COOLDOWN_SEC=5
# OPENWAKEWORD_CHUNK_SIZE=1280
# OPENWAKEWORD_INFERENCE_FRAMEWORK=onnx

