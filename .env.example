# Reference copy — production .env is generated by Ansible (make deploy).
# For manual docker compose without Ansible, copy to .env and edit.

TZ=Europe/Moscow
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_FAST=qwen3:4b
OLLAMA_MODEL_CHAT=qwen3:8b

DEFAULT_WEATHER_CITY=
DEFAULT_WEATHER_DISTRICT=

WEB_SEARCH_PROVIDER=off
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_PUBLIC_URL=http://localhost:18081

OPENWEATHER_API_KEY=
YANDEX_WEATHER_API_KEY=

HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

MEDIA_EXECUTOR_URL=

# RAG (scripts/rag/ingest.sh — docs/rag-qdrant.md)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=homelab_knowledge
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

GITLAB_EXTERNAL_URL=http://localhost:18090
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=19090

# Speaker recognition + personality middleware (profile voice — docs/hermes-speaker-personalization.md)
SPEAKER_RECOGNITION_PORT=8099
SPEAKER_PERSONALITY_MIDDLEWARE_PORT=8098
SPEAKER_SERVICE_URL=http://speaker-recognition:8099
SPEAKER_CONFIDENCE_THRESHOLD=0.7
SPEAKER_DEFAULT_PERSONALITY=adult
# PERSONALITY_MAP={"Alice":"child","Bob":"student"}
HERMES_URL=
